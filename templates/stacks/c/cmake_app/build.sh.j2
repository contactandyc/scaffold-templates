{#- scaffold-repo: { context: deps, executable: true } -#}
#!/usr/bin/env bash
set -Eeuo pipefail

# --- Discover and source scoped environment ---
_cur="$PWD"
while [ "$_cur" != "/" ]; do
  if [ -f "$_cur/.scaffoldrc.yaml" ]; then
    [ -f "$_cur/.scaffoldrc_{{ stack }}_{{ stack_type }}" ] && source "$_cur/.scaffoldrc_{{ stack }}_{{ stack_type }}"
    break
  fi
  _cur="$(dirname "$_cur")"
done
[ -z "${WORKSPACE_DIR:-}" ] && [ -f "$HOME/.scaffoldrc_{{ stack }}_{{ stack_type }}" ] && source "$HOME/.scaffoldrc_{{ stack }}_{{ stack_type }}"

# --- Script Commands ---
COMMAND="${1:-build}"

# --- Knobs ---
PREFIX="${PREFIX:-/usr/local}"
BUILD_DIR="${BUILD_DIR:-build}"
BUILD_TYPE="${BUILD_TYPE:-RelWithDebInfo}"
BUILD_VARIANT="${BUILD_VARIANT:-static}"
GENERATOR="${GENERATOR:-}"

pick_generator() {
  if [ -n "$GENERATOR" ]; then return; fi
  if command -v ninja >/dev/null; then GENERATOR="Ninja"
  elif command -v make >/dev/null; then GENERATOR="Unix Makefiles"
  else echo "Error: No build tool found. Install Ninja or Make." >&2; exit 1; fi
}

case "$COMMAND" in
  bootstrap)
    echo "--- Bootstrapping Hermetic Workspace ---"

    # 1. Isolate the Python scaffolding engine
    if [ ! -d ".scaffold/venv" ]; then
        echo "Creating isolated Python environment..."
        python3 -m venv .scaffold/venv
    fi
    source .scaffold/venv/bin/activate
    pip install --upgrade pip -q

    echo "Installing scaffold-repo CLI..."
    # Jinja safely checks if the block exists before accessing its properties
    pip install -q "git+{{ scaffold_repo.repo if scaffold_repo is defined and scaffold_repo.repo else 'https://github.com/contactandyc/scaffold-repo.git' }}@{{ scaffold_repo.ref if scaffold_repo is defined and scaffold_repo.ref else 'main' }}"

    # 2. Workspace Initialization
    if [ ! -f ".scaffoldrc.yaml" ]; then
        echo "⚙️  Seeding workspace defaults..."

        # Safely fetch the base_templates block
        cat <<EOF > .scaffoldrc.yaml
workspace_dir: "repos"
template_registry_url: "{{ base_templates.repo if base_templates is defined and base_templates.repo else 'https://github.com/contactandyc/scaffold-templates.git' }}"
template_registry_ref: "{{ base_templates.ref if base_templates is defined and base_templates.ref else 'main' }}"
EOF

        # Check if we have a real human terminal AND we are not in a CI runner
        if [ -t 0 ] && [ -z "${CI:-}" ]; then
            echo "⚙️  Launching interactive workspace setup..."
            scaffold-init
        else
            echo "⚙️  Headless environment detected. Auto-configuring hermetic defaults..."
            # Since the wizard won't run, manually write the scoped bash variables
            cat <<EOF > .scaffoldrc_{{ stack }}_{{ stack_type }}
export WORKSPACE_DIR="\$PWD/repos"
export PREFIX="\$PWD/repos/install"
export BUILD_TYPE="RelWithDebInfo"
export BUILD_VARIANT="static"
EOF
        fi
    fi

    # 3. Trigger the Engine
    echo "🏗️  Resolving dependency graph..."
    scaffold-repo --build-deps

    echo ""
    echo "✅ Bootstrap complete! All dependencies are isolated in your workspace."
    echo "   Run './build.sh build' to compile this project."
    ;;

  build|install)
    pick_generator
    echo "--- Building Application (Generator: $GENERATOR, Type: $BUILD_TYPE, Linking: $BUILD_VARIANT) ---"

    cmake -S . -B "$BUILD_DIR" -G "$GENERATOR" \
      -DCMAKE_BUILD_TYPE="$BUILD_TYPE" \
      -DCMAKE_PREFIX_PATH="$PREFIX" \
      -DCMAKE_INSTALL_PREFIX="$PREFIX" \
      -DA_BUILD_VARIANT="$BUILD_VARIANT"

    cmake --build "$BUILD_DIR" -j

    if [ "$COMMAND" = "install" ]; then
      echo "--- Installing to '$PREFIX' ---"
      INSTALL_SUDO=""
      if [[ "$PREFIX" == "/usr"* ]] && [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
        INSTALL_SUDO="sudo"
      fi
      $INSTALL_SUDO cmake --install "$BUILD_DIR"
      echo "✅ Install complete."
    else
      echo "✅ Build complete. Artifacts are in '$BUILD_DIR/'."
    fi
    ;;

  clean)
    echo "--- Cleaning Build Directories ---"
    rm -rf "$BUILD_DIR"
    echo "✅ Clean complete."
    ;;

  *)
    echo "Usage: $0 [build|install|clean]" >&2
    exit 1
    ;;
esac
