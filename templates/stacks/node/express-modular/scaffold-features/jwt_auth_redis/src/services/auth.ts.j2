import bcrypt from 'bcrypt';
import jwt from 'jsonwebtoken';
import { createClient } from 'redis';

const JWT_SECRET = process.env.JWT_SECRET || 'super-secret-development-key';
const SALT_ROUNDS = 10;

const client = createClient({
  url: process.env.REDIS_URL || 'redis://localhost:6379'
});

client.on('error', (err: any) => console.error('Redis Auth Client Error', err));

// Note: In a production app, the Redis connection should be centralized
// to prevent multiple clients from spawning.
client.connect().catch(console.error);

export const registerUser = async (username: string, passwordRaw: string) => {
  const userKey = `user:${username}`;

  // 1. Check if the user already exists
  const exists = await client.exists(userKey);
  if (exists) {
    throw new Error('User already exists');
  }

  // 2. Hash the password and generate a unique ID
  const hashedPassword = await bcrypt.hash(passwordRaw, SALT_ROUNDS);
  const userId = String(Date.now()); // Simple ID generation for demonstration

  // 3. Store the user data in a Redis Hash
  await client.hSet(userKey, {
    id: userId,
    username: username,
    password_hash: hashedPassword
  });

  return { id: userId, username };
};

export const loginUser = async (username: string, passwordRaw: string) => {
  const userKey = `user:${username}`;

  // 1. Fetch the user hash from Redis
  const user = await client.hGetAll(userKey);

  // hGetAll returns an empty object if the key doesn't exist
  if (!user || !user.password_hash) {
    throw new Error('Invalid username or password');
  }

  // 2. Verify the password
  const isMatch = await bcrypt.compare(passwordRaw, user.password_hash);
  if (!isMatch) {
    throw new Error('Invalid username or password');
  }

  // 3. Sign and return the JWT
  return jwt.sign(
    { id: user.id, username: user.username },
    JWT_SECRET,
    { expiresIn: '24h' }
  );
};
