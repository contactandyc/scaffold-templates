{#- scaffold-repo: { dest: "package.json" } -#}
{
  "name": "{{ project_slug }}",
  "version": "{{ version | default('0.1.0') }}",
  "description": "{{ description | default('A dynamically scaffolded node/express-modular project') }}",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    {% if kv_backend == 'redis' %}    "redis": "^4.6.13",
    {% endif %}
    {% if kv_backend == 'postgres' %}    "pg": "^8.11.3",
    {% endif %}
    {% if websockets == 'yes' or websockets == true %}    "socket.io": "^4.7.5",
    {% endif %}
    {% if jwt_auth in ['yes', true, 'true', 'True'] %}    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    {% endif %}
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    {% if kv_backend == 'postgres' %}    "@types/pg": "^8.11.2",
    {% endif %}
    {% if jwt_auth in ['yes', true, 'true', 'True'] %}    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    {% endif %}
    "ts-node": "^10.9.2"
  }
}
